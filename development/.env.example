# Compose project name (official Docker Compose env var — keeps this stack's
# volumes/networks/containers from clashing with other projects on the host).
COMPOSE_PROJECT_NAME=nautobot-scanner-dev

# Reverse-proxy hostname. Pointed at the host by your DNS / hosts file.
# Caddy on the `caddy` external network terminates TLS and proxies to the
# nautobot-web container.
DOMAIN=scanner.local.example.com

# --- Nautobot ---------------------------------------------------------------
NAUTOBOT_DB_NAME=nautobot
NAUTOBOT_DB_USER=nautobot
NAUTOBOT_DB_PASSWORD=changeme-postgres
NAUTOBOT_REDIS_PASSWORD=changeme-redis
NAUTOBOT_SECRET_KEY=changeme-secret-key-50-chars-or-more-please-rotate-this

NAUTOBOT_SUPERUSER_NAME=admin
NAUTOBOT_SUPERUSER_EMAIL=admin@example.com
NAUTOBOT_SUPERUSER_PASSWORD=changeme-admin
NAUTOBOT_SUPERUSER_API_TOKEN=0123456789abcdef0123456789abcdef01234567
