# Required: Nautobot URL + agent registration credentials.
NAUTOBOT_URL=https://scanner.local.example.com
AGENT_ID=00000000-0000-0000-0000-000000000000
AGENT_TOKEN=replace-with-the-token-shown-after-creating-the-ScannerAgent

# Self-signed cert? Set to "false" to skip TLS verification (dev only).
VERIFY_TLS=true

# Polling cadence — how often the agent asks Nautobot for new scan work.
POLL_INTERVAL_SECONDS=30

# Heartbeat cadence — keeps the ScannerAgent in "online" status. The
# MarkStaleAgents Job in Nautobot flips agents to "offline" if last_seen
# is older than 3 × this interval.
CHECKIN_INTERVAL_SECONDS=60

# Per-scan timeout. Default 1h — adjust upward for /16-on-T0 scans.
SCAN_TIMEOUT_SECONDS=3600

# Optional. Defaults to INFO. Use DEBUG to trace HTTP traffic.
AGENT_LOG_LEVEL=INFO

# Container name override for docker compose (defaults to scanner-agent-*).
COMPOSE_PROJECT_NAME=scanner-agent-dmz
