# Template for agent/.env.dev-bridge — used by the bridge-mode reference
# agent that attaches to the Nautobot Compose stack's internal network and
# scans whatever services are on it. Copy this to .env.dev-bridge and fill
# in real values; the real file is gitignored.
#
# To bootstrap: spin up the agent in the Nautobot UI (Scanner → Agents →
# Add), then run development/scripts/seed_bridge_agent.py to grab the UUID +
# token and stamp them in here.

AGENT_ID=00000000-0000-0000-0000-000000000000
AGENT_TOKEN=replace-with-real-token-after-agent-create
COMPOSE_PROJECT_NAME=scanner-agent-dev-bridge
