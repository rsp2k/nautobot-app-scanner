# Environments / secrets
# Ignore EVERY dotenv variant by default; whitelist only the public templates below.
# This catches `.env`, `.env.local`, `.env.production`, `.env.dev-bridge`, etc. —
# previously each new variant slipped through (we shipped agent/.env.dev-bridge with
# a real token before this rule existed). Two conventions collided here:
#   - Next.js / CRA style: `.env`, `.env.local`, `.env.<env>.local`
#   - docker-compose style: `.env.<variant>` (paralleling docker-compose.<variant>.yml)
# `.env.*` covers both — whatever convention future devs reach for, they're caught.
.env
.env.*

# Public templates — must be tracked. Negation patterns MUST come after the
# ignore rules they're un-ignoring.
!.env.example
!.env.*.example

# Local-only screenshots / audits / pixel artifacts. JPEGs are pixel data so we
# can't grep them for PII after capture — exclude the whole tree and rely on the
# sanitize-before-screenshot workflow when something genuinely needs publishing.
artifacts/

# Python build artifacts
# uv.lock: this app is a Nautobot plugin (consumed by Nautobot's own
# dependency resolver), so the lock file is dev-cache rather than
# reproducibility truth — keep it out of git to avoid lockfile drift
# between contributors using different Python versions.
uv.lock

__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.eggs/
dist/
build/
wheels/

# Caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Editors
.idea/
.vscode/
*.swp
*~

# Docs build outputs
site/
# mkdocs writes built HTML here per `site_dir` in mkdocs.yml — generated,
# don't track. The app-bundled `static/nautobot_scanner/img/` next to it
# IS tracked (that's where our SVG nav icon lives).
src/nautobot_scanner/static/nautobot_scanner/docs/

# Local-only artifacts
/local/
audits/

# Nautobot dev-stack persistent data lives in named volumes; this only matters
# if someone runs nautobot-server directly on the host. App-bundled static
# under src/nautobot_scanner/static/ is intentionally tracked.
/media/
/static/
